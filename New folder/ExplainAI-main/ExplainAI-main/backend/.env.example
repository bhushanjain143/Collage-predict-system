# Copy to .env (do not commit .env). Flask loads these if you use python-dotenv later;
# for now set them in your shell or on Render / Railway.

SECRET_KEY=change-me-to-a-long-random-string

# SQLite default: leave DATABASE_URL unset, DB is backend/instance/explainai.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host/dbname

# Optional: enable real LLM text on /api/ai/explain (one key is enough)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Render / Railway set PORT automatically; local default is 5000 in app.py
# PORT=5000
